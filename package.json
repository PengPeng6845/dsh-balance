{
  "name": "@pengpeng6845/dsh-balance",
  "description": "Real API balance monitoring for the DeepSeek Harness: polls the official /user/balance endpoint with your API key and shows the true remaining balance in the sidebar",
  "version": "0.7.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "cordis",
    "balance",
    "billing",
    "usage",
    "monitor"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PengPeng6845/dsh-balance.git"
  },
  "bugs": {
    "url": "https://github.com/PengPeng6845/dsh-balance/issues"
  },
  "homepage": "https://github.com/PengPeng6845/dsh-balance#readme",
  "scripts": {
    "test": "node test/smoke.mjs",
    "release": "node scripts/release.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
